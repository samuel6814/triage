# --- Local development -------------------------------------------------------
# Default: baseline BioBERT (original triage_new.ipynb fine-tune).
MODEL_PATH=../../../fine-tuned-biobert/fine_tuned_biobert_triage-20260602T132911Z-3-001/fine_tuned_biobert_triage

# Optional SMOTE override for A/B testing:
# MODEL_PATH=../../../fine-tuned-biobert/fine_tuned_biobert_triage_smote

# Production: set MODEL_ID to your Hugging Face Hub repo (upload baseline weights).
# MODEL_ID=your-username/curatio-biobert-triage

# OpenMed — lazy-loaded on first ?openmed=true or /analyze call (not on every predict)
OPENMED_ENABLED=true
# Default false: baseline BioBERT was not trained with [DISEASE:]/[DRUG:] prefixes
OPENMED_ENTITY_PREFIX=false
# NER span confidence cutoff (0–1)
OPENMED_CONFIDENCE_THRESHOLD=0.5
# Max seconds for NER before acuity continues with entities_status=error
# (cold load of two 434M models can take ~30s; after warmup should be <<1s)
OPENMED_TIMEOUT_SECONDS=45
# Prefetch disease+pharma NER pipelines in a background thread on ML startup
OPENMED_WARM_ON_STARTUP=true
# Optional Hugging Face token (faster/authenticated model downloads)
# HF_TOKEN=
# DeBERTa-v2 PII models need eager attention (SDPA is unsupported)
OPENMED_TORCH_ATTENTION_BACKEND=eager

# Fusion
SUPPRESS_TEWS_GREEN_WHEN_INCOMPLETE=true
DISCRIMINATOR_THRESHOLD=0.85
BAYES_MI_THRESHOLD=0.75

# Minimum clinical relevance score (0–1) before BioBERT triage runs.
CLINICAL_RELEVANCE_THRESHOLD=0.35

# Voice intake (Twi record → Whisper → translate)
VOICE_MAX_BYTES=10485760
WHISPER_MODEL_SIZE=small
VOICE_TRANSLATION_ENABLED=true
