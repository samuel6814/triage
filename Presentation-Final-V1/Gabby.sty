\newcommand{\tensor}[2]{ {#1}^{ \otimes {#2} } }
\newcommand{\overeq}[1]{\stackrel{{#1}}{=}}
\newcommand{\pd}[1]{\partial #1}
\newcommand{\norm}[1]{\left\vert {#1}\right\vert }
\newcommand{\parent}[1]{\left(#1\right)}
\newcommand{\Brace}[1]{\left[#1\right]}
\newcommand{\Leftb}[1]
{
	\left\{\begin{array}{lcl}
		#1
	\end{array}
	\right.
}

\newcommand{\set}[1]{\left\{ {#1} \right\}} %{ \Big\{{#1}\Big\} }
\newcommand{\vect}[1]{\overrightarrow{#1}}
\newcommand{\mb}[1]{#1}  
\newcommand{\mbb}[1]{\mathbb{#1}}
\newcommand{\mf}[1]{\mathbf{#1}} 
\newcommand{\mc}[1]{\mathcal{#1}}
\newcommand{\abs}[1]{\left\vert  {#1} \right\vert}
\newcommand{\defset}[2]{\left\{\ {#1} \ \vert \ {#2} \right\}}
\newcommand{\inp}[1]{\langle {#1}\rangle }

\newcommand{\Sum}[2]{\displaystyle{\sum_{#1}^{#2}}}
\newcommand{\+}{\star}
\newcommand{\bvec}[1][r]{\mathbf{#1}}
\newcommand{\floor}[1]{\left\lfloor #1 \right\rfloor}
\newcommand{\eqvo}{\Longleftrightarrow}
\newcommand{\Vect}[1]{\overrightarrow{#1}}
\newcommand{\dg}[1]{{#1}^{\circ}}
\newcommand{\fdef}[5][f]{
	\begin{matrix}
		{#1} :& {#2} & \to & {#3}\\
		& {#4} & \mapsto& {#5}
	\end{matrix}
}

\newcommand{\fdeff}[5][f]{
	\begin{tabular}{rlll}
		{#1} :& {#2} & $\to$ & {#3}\\
		& {#4} & $\mapsto$& {#5}
	\end{tabular}
}

\newcommand{\Limf}[3][x]{\displaystyle \lim_{{#1} \to {#3}}{#2}({#1})}
\newcommand{\Lim}[2][x]{\displaystyle \lim_{{#1} \to {#2}} }





